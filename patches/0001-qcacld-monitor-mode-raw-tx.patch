 #ifdef FEATURE_MONITOR_MODE_SUPPORT
-/* Monitor mode net_device_ops, doesnot Tx and most of operations. */
+/*
+ * HTT_INVALID_PEER / HTT_TX_EXT_TID_INVALID live in fw-api/fw/htt_common.h,
+ * which is not on the HDD include path; mirror the two values locally.
+ */
+#define HDD_MON_TX_PEER_ID_INVALID 0xffff
+/*
+ * TID передаём ВАЛИДНЫЙ (0), а не HTT_TX_EXT_TID_INVALID(31): датапат использует
+ * его как индекс в pdev->stats.tid_stats.tid_tx_stats[ring][tid], где размерность
+ * CDP_MAX_DATA_TIDS = 9. С 31 это выход за границы массива, UBSAN ловит его
+ * ловушкой brk #0x5512 и ядро уходит в панику прямо в dp_tx_send_msdu_single.
+ */
+#define HDD_MON_TX_TID_BEST_EFFORT 0
+
+/*
+ * <net/ieee80211_radiotap.h> cannot be pulled in here: qcacld's
+ * cds_ieee80211_common_i.h defines IEEE80211_CHAN_* as macros, which collide
+ * with the enumerators of the same name in that header. Only the fixed-size
+ * front of the radiotap header is needed, so mirror it locally.
+ */
+struct hdd_mon_radiotap_hdr {
+	uint8_t it_version;
+	uint8_t it_pad;
+	__le16 it_len;
+	__le32 it_present;
+} __packed;
+
+/**
+ * hdd_mon_hard_start_xmit() - TX handler for the monitor netdev
+ * @skb: radiotap header followed by a bare 802.11 frame
+ * @dev: monitor net_device (ARPHRD_IEEE80211_RADIOTAP)
+ *
+ * Stock qcacld leaves wlan_mon_drv_ops without an ndo_start_xmit, so the
+ * kernel drops every frame userspace writes to the monitor interface before
+ * the driver ever sees it. Strip the radiotap header and push the bare 802.11
+ * frame into the datapath exception path, which knows how to transmit
+ * htt_cmn_pkt_type_raw MSDUs.
+ *
+ * Return: NETDEV_TX_OK always; failures free the skb and bump tx_dropped.
+ */
+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct cdp_tx_exception_metadata tx_exc_meta = {0};
+	struct hdd_mon_radiotap_hdr *rtap;
+	ol_txrx_soc_handle soc;
+	uint32_t tx_len;
+	uint16_t rtap_len;
+
+	soc = cds_get_context(QDF_MODULE_ID_SOC);
+	if (!soc || !adapter)
+		goto drop;
+
+	if (skb->len < sizeof(*rtap))
+		goto drop;
+
+	rtap = (struct hdd_mon_radiotap_hdr *)skb->data;
+	if (rtap->it_version)
+		goto drop;
+
+	rtap_len = le16_to_cpu(rtap->it_len);
+	if (rtap_len < sizeof(*rtap) || rtap_len >= skb->len)
+		goto drop;
+
+	/* the datapath rewrites headers in place, so we need a private copy */
+	if (skb_shared(skb) || skb_cloned(skb)) {
+		struct sk_buff *nskb = skb_unshare(skb, GFP_ATOMIC);
+
+		if (!nskb) {
+			/* skb_unshare() consumed the original on failure */
+			dev->stats.tx_dropped++;
+			return NETDEV_TX_OK;
+		}
+		skb = nskb;
+	}
+
+	skb_pull(skb, rtap_len);
+	tx_len = skb->len;
+
+	tx_exc_meta.peer_id = HDD_MON_TX_PEER_ID_INVALID;
+	tx_exc_meta.tid = HDD_MON_TX_TID_BEST_EFFORT;
+	tx_exc_meta.tx_encap_type = htt_cmn_pkt_type_raw;
+	tx_exc_meta.sec_type = cdp_sec_type_none;
+
+	/* a non-NULL return means the datapath did not take the buffer */
+	if (cdp_tx_send_exc(soc, adapter->vdev_id, (qdf_nbuf_t)skb,
+			    &tx_exc_meta))
+		goto drop;
+
+	dev->stats.tx_packets++;
+	dev->stats.tx_bytes += tx_len;
+	netif_trans_update(dev);
+
+	return NETDEV_TX_OK;
+
+drop:
+	dev->stats.tx_dropped++;
+	kfree_skb(skb);
+
+	return NETDEV_TX_OK;
+}
+
+/* Monitor mode net_device_ops; Tx goes through the raw exception path. */
 static const struct net_device_ops wlan_mon_drv_ops = {
 	.ndo_open = hdd_mon_open,
 	.ndo_stop = hdd_stop,
 	.ndo_get_stats = hdd_get_stats,
+	.ndo_start_xmit = hdd_mon_hard_start_xmit,
 };
 
