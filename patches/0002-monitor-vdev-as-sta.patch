+		 *
+		 * Возможные последствия: прошивка может ждать привязанного peer
+		 * для STA-vdev, а настройка приёма в monitor-режиме может
+		 * сломаться. Проверяется одним тестом.
+		 */
+		*type = WLAN_VDEV_MLME_TYPE_STA;
 		break;
 	case QDF_NDI_MODE:
