--- a/drivers/staging/qcacld-3.0/components/mlme/core/src/wlan_mlme_vdev_mgr_interface.c
+++ b/drivers/staging/qcacld-3.0/components/mlme/core/src/wlan_mlme_vdev_mgr_interface.c
@@ -1249,7 +1249,24 @@
 		*type = WLAN_VDEV_MLME_TYPE_IBSS;
 		break;
 	case QDF_MONITOR_MODE:
-		*type = WMI_HOST_VDEV_TYPE_MONITOR;
+		/*
+		 * ЭКСПЕРИМЕНТ (этап 2): объявляем monitor-vdev как STA.
+		 *
+		 * Прошивка QCA6490 отбрасывает передачу с vdev типа MONITOR(4):
+		 * кадры доходят до датапата (kprobe: 640 вызовов
+		 * hdd_mon_hard_start_xmit), драйвер ошибок не пишет, но в эфир
